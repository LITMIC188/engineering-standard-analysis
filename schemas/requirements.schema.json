{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESA standard requirements v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "standard_id",
    "edition",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "standard_id": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "source_inventory": {"type":"object","required":["validated","file","sha256","sections","normative_annex_ids","table_ids","figure_ids","reference_ids"],"properties":{
      "validated":{"type":"boolean"},"file":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
      "sections":{"type":"array","items":{"type":"object","required":["id","block_id","source"],"properties":{"id":{"type":"string"},"block_id":{"type":"string"},"source":{"type":"object"}}}},
      "normative_annex_ids":{"type":"array","items":{"type":"string"}},"table_ids":{"type":"array","items":{"type":"string"}},
      "figure_ids":{"type":"array","items":{"type":"string"}},"reference_ids":{"type":"array","items":{"type":"string"}}}},
    "source_inventory_review": {"type":"object","properties":{
      "status":{"enum":["pending","source_checked"]},"source_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
      "reviewer":{"type":"string","minLength":1},"reviewed_at":{"type":"string","minLength":1},"approval_evidence":{"type":"string","minLength":1}}},
    "modeled_inventory": {"type":"object","properties":{"validated":{"type":"boolean"},"file":{"type":"string"},
      "sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},"sections":{"type":"array"},
      "normative_annex_ids":{"type":"array","items":{"type":"string"}},"table_ids":{"type":"array","items":{"type":"string"}},
      "figure_ids":{"type":"array","items":{"type":"string"}},"reference_ids":{"type":"array","items":{"type":"string"}}}},
    "source_page_coverage":{"type":"object","properties":{"complete":{"type":"boolean"},
      "expected_page_locators":{"type":"array","items":{"type":"string"}},"modeled_page_locators":{"type":"array","items":{"type":"string"}},
      "missing_page_locators":{"type":"array","items":{"type":"string"}}}},
    "coverage": {"type":"object","properties":{
      "required_sections":{"type":"array","items":{"type":"string"}},"modeled_sections":{"type":"array","items":{"type":"string"}},
      "normative_annexes":{"type":"array","items":{"type":"string"}},"modeled_annexes":{"type":"array","items":{"type":"string"}},
      "tables":{"$ref":"#/$defs/object_inventory"},"figures":{"$ref":"#/$defs/object_inventory"}}},
    "reference_closure": {"type":"object","properties":{"references":{"type":"array","items":{"type":"object","required":["reference_id","file","sha256","status","resolution_review"],"properties":{
      "reference_id":{"type":"string"},"file":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},"status":{"enum":["resolved","unresolved","pending"]},"resolution_review":{"type":"object"}}}}}},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "clause_id",
          "summary",
          "applicability",
          "source",
          "source_verified",
          "review_status"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "clause_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "requirement_level": {
            "enum": [
              "mandatory",
              "recommended",
              "permitted",
              "informative",
              "unknown"
            ]
          },
          "applicability": {
            "enum": [
              "applicable",
              "conditional",
              "not_applicable",
              "unknown"
            ]
          },
          "test_criteria": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_verified": {
            "type": "boolean"
          },
          "review_status": {
            "enum": [
              "draft",
              "source_checked",
              "engineering_reviewed",
              "approved",
              "blocked"
            ]
          },
          "audit_obligation": {"enum":["mandatory","recommended","permitted","informative","unknown"]},
          "normative_nature": {"enum":["normative","informative","unknown"]},
          "source_spans": {"type":"array","minItems":1,"items":{"anyOf":[
            {"type":"object","required":["sequence","locator","quote","source"],"properties":{"sequence":{"type":"integer","minimum":1},"locator":{"type":"string"},"quote":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source_location"}},"additionalProperties":true},
            {"type":"object","required":["source","quote"],"properties":{"quote":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source_location"}},"additionalProperties":true}] }},
          "risk_factors": {"type":"object","additionalProperties":{"enum":["low","medium","high","unknown"]}},
          "risk_review": {"type":["object","null"]},
          "source": {
            "type": "object",
            "required": [
              "file",
              "sha256",
              "standard_id",
              "edition",
              "pdf_page"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              },
              "standard_id": {
                "type": "string",
                "minLength": 1
              },
              "edition": {
                "type": "string",
                "minLength": 1
              },
              "pdf_page": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "page_kind": {"type": "string", "enum": ["pdf", "html", "docx", "xlsx", "text", "section", "other"]},
              "locator": {"type": ["string", "null"]},
              "quote": {"type": ["string", "null"]},
              "printed_page": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "table_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "figure_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs":{"source_location":{"type":"object","required":["file","sha256","pdf_page","page_kind","locator"],"properties":{"file":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},"pdf_page":{"type":["integer","null"]},"page_kind":{"type":"string"},"locator":{"type":"string"}}},
    "object_inventory":{"type":"object","required":["expected_ids","modeled_ids","review"],"properties":{"expected_ids":{"type":"array","items":{"type":"string"}},"modeled_ids":{"type":"array","items":{"type":"string"}},"review":{"type":"object"}}}}
}
