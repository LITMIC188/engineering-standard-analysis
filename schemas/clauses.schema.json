{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ESA located source blocks v2.1 (v2 contract)",
  "type":"object",
  "required":["schema_version","standard_id","edition","source","blocks"],
  "properties":{
    "schema_version":{"const":"2.0"},
    "standard_id":{"type":"string","minLength":1},
    "edition":{"type":"string","minLength":1},
    "source":{"type":"object","required":["file","sha256"],"properties":{"file":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"}}},
    "blocks":{"type":"array","items":{"type":"object","required":["block_id","clause_id","source_lang","original_text","source"],"properties":{
      "block_id":{"type":"string","minLength":1},"clause_id":{"type":"string","minLength":1},
      "source_lang":{"type":"string","minLength":2},"original_text":{"type":"string","minLength":1},
      "kind":{"enum":["clause","table","figure","note","annex"]},
      "protected_tokens":{"type":"array","items":{"type":"string"}},
      "source":{"$ref":"#/$defs/location"},
      "spans":{"type":"array","minItems":1,"items":{"type":"object","required":["source","quote"],"properties":{"source":{"$ref":"#/$defs/location"},"quote":{"type":"string","minLength":1}}}}
    }}}
  },
  "$defs":{"location":{"type":"object","required":["file","sha256","pdf_page","page_kind","locator"],"properties":{
    "file":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"},
    "pdf_page":{"type":["integer","null"],"minimum":1},"page_kind":{"enum":["pdf","section","text"]},
    "locator":{"type":"string","minLength":1},"printed_page":{"type":["string","null"]}
  },"allOf":[{"if":{"properties":{"page_kind":{"const":"pdf"}}},"then":{"properties":{"pdf_page":{"type":"integer","minimum":1}}},"else":{"properties":{"pdf_page":{"const":null}}}}]}}
}
